            },
            {
              "name": "400 Bad Request – Validation Error",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"ValidationError\",\n  \"action\": \"Fix the highlighted fields and try again.\",\n  \"message\": \"Invalid input data.\",\n  \"status_code\": 400,\n  \"fields\": {\n    \"text\": [\"Must be at least 1 character.\"]\n  }\n}",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/to-do",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"text\": \"\"\n}",
                  "options": { "raw": { "language": "json" } }
                }
              }
            },
            {
              "name": "401 Unauthorized – Token Not Provided",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"UnauthorizedError\",\n  \"action\": \"Sign in to continue.\",\n  \"message\": \"Token not provided.\",\n  \"status_code\": 401\n}",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/to-do",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"text\": \"Buy groceries\"\n}",
                  "options": { "raw": { "language": "json" } }
                }
              }
            }
          ]
        },
        {
          "name": "Update todo",
          "request": {
            "method": "PUT",
            "description": "Replaces the `text` of an existing to-do item.\n\n**Auth required:** Yes\n\nSupply the todo's UUID as the `:id` path variable. Only items owned by the authenticated user can be updated.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/to-do/:id",
              "host": ["{{baseUrl}}"],
              "path": ["to-do", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "PASTE_TODO_ID_HERE",
                  "description": "UUID of the to-do item to update."
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Buy groceries and cook dinner\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 OK – Todo Updated",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"todo\": {\n    \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"text\": \"Buy groceries and cook dinner\",\n    \"done\": false,\n    \"order\": 0\n  }\n}",
              "originalRequest": {
                "method": "PUT",
                "url": {
                  "raw": "{{baseUrl}}/to-do/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["to-do", ":id"],
                  "variable": [{ "key": "id", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890" }]
                },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"text\": \"Buy groceries and cook dinner\"\n}",
                  "options": { "raw": { "language": "json" } }
                }
              }
            },
            {
              "name": "400 Bad Request – Validation Error",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"ValidationError\",\n  \"action\": \"Fix the highlighted fields and try again.\",\n  \"message\": \"Invalid input data.\",\n  \"status_code\": 400,\n  \"fields\": {\n    \"text\": [\"Must be at least 1 character.\"]\n  }\n}",
              "originalRequest": {
                "method": "PUT",
                "url": {
                  "raw": "{{baseUrl}}/to-do/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["to-do", ":id"],
                  "variable": [{ "key": "id", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890" }]
                },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"text\": \"\"\n}",
                  "options": { "raw": { "language": "json" } }
                }
              }
            },
            {
              "name": "401 Unauthorized – Token Not Provided",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"UnauthorizedError\",\n  \"action\": \"Sign in to continue.\",\n  \"message\": \"Token not provided.\",\n  \"status_code\": 401\n}",
              "originalRequest": {
                "method": "PUT",
                "url": {
                  "raw": "{{baseUrl}}/to-do/:id",
