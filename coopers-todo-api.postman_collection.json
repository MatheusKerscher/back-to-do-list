        {
          "name": "Check / Uncheck todo",
          "request": {
            "method": "PATCH",
            "description": "Toggles the `done` status of a to-do item (`false` → `true` or `true` → `false`).\n\n**Auth required:** Yes\n\nNo request body is needed. Supply the todo's UUID as the `:id` path variable.",
            "url": {
              "raw": "{{baseUrl}}/to-do/:id/check",
              "host": ["{{baseUrl}}"],
              "path": ["to-do", ":id", "check"],
              "variable": [
                {
                  "key": "id",
                  "value": "PASTE_TODO_ID_HERE",
                  "description": "UUID of the to-do item to toggle."
                }
              ]
            },
            "header": []
          },
          "response": [
            {
              "name": "200 OK – Todo Checked",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"todo\": {\n    \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"text\": \"Buy groceries\",\n    \"done\": true,\n    \"order\": 0\n  }\n}",
              "originalRequest": {
                "method": "PATCH",
                "url": {
                  "raw": "{{baseUrl}}/to-do/:id/check",
                  "host": ["{{baseUrl}}"],
                  "path": ["to-do", ":id", "check"],
                  "variable": [{ "key": "id", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890" }]
                },
                "header": []
              }
            },
            {
              "name": "401 Unauthorized – Token Not Provided",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"UnauthorizedError\",\n  \"action\": \"Sign in to continue.\",\n  \"message\": \"Token not provided.\",\n  \"status_code\": 401\n}",
              "originalRequest": {
                "method": "PATCH",
                "url": {
