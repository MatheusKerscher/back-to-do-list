{
  "name": "back-to-do-list",
  "version": "1.0.0",
  "description": "API to Coopers technical challenge ",
  "keywords": [
    "API",
    "Node",
    "Axios"
  ],
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "services:up": "docker compose up -d --remove-orphans",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "services:wait:database": "node scripts/wait-for-postgres.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node scripts/test.js",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "1.16.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "resend": "6.12.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.9.0",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "cross-env": "10.1.0",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "prettier": "3.8.3",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.10",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
